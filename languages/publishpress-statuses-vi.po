msgstr "Cung cấp một nhãn và một slug trạng thái không số chưa sử dụng."

#: Mcp/Actions.php:316
#: StatusHandler.php:115
msgid "Name conflicts with existing status. Please choose another."
msgstr "Tên bị trùng với trạng thái hiện có. Vui lòng chọn một tên khác."

#: Mcp/Actions.php:330
msgid ""
"Choose a top-level moderation parent without creating a cycle or third "
"nesting level."
msgstr ""
"Chọn một cha mẹ điều chỉnh cấp cao mà không tạo ra chu trình hoặc cấp độ "
"lồng ghép thứ ba."

#: Mcp/Actions.php:365
msgid ""
"Native status authorization changed. Some changes may have been saved; read "
"the status before retrying."
msgstr ""
"Quyền xác thực trạng thái gốc đã thay đổi. Một số thay đổi có thể đã được "
"lưu; đọc trạng thái trước khi thử lại."

#: Mcp/Actions.php:498
msgid "Retain the native section-marker order."
msgstr "Giữ nguyên thứ tự dấu hiệu phân đoạn gốc."

#: Mcp/Actions.php:501
msgid "Retain every current status and section marker exactly once."
msgstr "Giữ lại mọi trạng thái hiện tại và dấu hiệu phân đoạn chính xác một lần."

#: Mcp/Actions.php:504
msgid "Keep statuses within the sections allowed by the native workflow editor."
msgstr ""
"Giữ các trạng thái trong các phần được phép bởi trình chỉnh sửa luồng công "
"việc gốc."

#: Mcp/Actions.php:631
msgid "Select a native permission-inheritance choice from discovery."
msgstr "Chọn một tùy chọn kế thừa quyền gốc từ phát hiện."

#: Mcp/Actions.php:730
msgid "Use native editing for post types without REST support."
msgstr "Sử dụng chỉnh sửa gốc cho các loại bài viết không hỗ trợ REST."

#: Mcp/Actions.php:734
msgid "This post type uses a custom controller; use its native editor."
msgstr ""
"Loại bài viết này sử dụng một bộ điều khiển tùy chỉnh; sử dụng trình chỉnh "
"sửa gốc của nó."

#: Mcp/Actions.php:785
msgid "A post may occur only once in a batch."
msgstr "Một bài viết chỉ có thể xuất hiện một lần trong một lô."

#: Mcp/Actions.php:813
msgid "Only user-created statuses can be deleted through MCP."
msgstr "Chỉ trạng thái do người dùng tạo mới có thể bị xóa qua MCP."

#: Mcp/Actions.php:819
msgid "Move or remove child statuses before deleting their parent."
msgstr "Di chuyển hoặc xóa trạng thái con trước khi xóa cha mẹ của chúng."

#: Mcp/Actions.php:822
msgid "Choose the native deletion destination, Draft."
msgstr "Chọn đích xóa gốc, Bản nháp."

#: Mcp/Actions.php:826
msgid "Remove native visibility conditions before deleting this status."
msgstr "Xóa điều kiện hiển thị gốc trước khi xóa trạng thái này."

#: Mcp/Actions.php:839
msgid ""
"Revision records still use this definition. Use the native revision "
"workflow."
msgstr ""
"Các bản ghi phiên bản vẫn sử dụng định nghĩa này. Sử dụng luồng công việc "
"phiên bản gốc."

#: Mcp/Actions.php:842
msgid "Use native administration for this deletion."
msgstr "Sử dụng quản trị gốc cho việc xóa này."

#: Mcp/Actions.php:858
msgid "Use native administration to reassign posts with visibility locks."
msgstr "Sử dụng quản trị gốc để gán lại các bài viết với khóa hiển thị."

