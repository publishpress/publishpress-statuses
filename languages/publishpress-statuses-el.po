msgid "Revision approval and scheduling"
msgstr "Έγκριση και προγραμματισμός αναθεώρησης"

#: Mcp/Actions.php:99
msgid "Notification workflows"
msgstr "Ροές εργασίας ειδοποίησης"

#: Mcp/Actions.php:265
msgid "Unknown status."
msgstr "Άγνωστη κατάσταση."

#: Mcp/Actions.php:293
msgid "An existing status cannot change taxonomy."
msgstr "Μια υπάρχουσα κατάσταση δεν μπορεί να αλλάξει την κατηγορία."

#: Mcp/Actions.php:307
msgid "Supply a label and an unused nonnumeric status slug."
msgstr ""
"Δώστε μια ετικέτα και μια μη αριθμητική κατάσταση slug που δεν "
"χρησιμοποιείται."

#: Mcp/Actions.php:316
#: StatusHandler.php:115
msgid "Name conflicts with existing status. Please choose another."
msgstr "Το όνομα συγκρούεται με υπάρχουσα κατάσταση. Παρακαλώ επιλέξτε άλλο."

#: Mcp/Actions.php:330
msgid ""
"Choose a top-level moderation parent without creating a cycle or third "
"nesting level."
msgstr ""
"Επιλέξτε έναν γονέα μετριασμού κορυφαίου επιπέδου χωρίς να δημιουργήσετε "
"κύκλο ή τρίτο επίπεδο φωλιάσματος."

#: Mcp/Actions.php:365
msgid ""
"Native status authorization changed. Some changes may have been saved; read "
"the status before retrying."
msgstr ""
"Η εξουσιοδότηση της εγγενής κατάστασης άλλαξε. Ορισμένες αλλαγές μπορεί να "
"έχουν αποθηκευτεί. Διαβάστε την κατάσταση πριν ξαναδοκιμάσετε."

#: Mcp/Actions.php:498
msgid "Retain the native section-marker order."
msgstr "Διατηρήστε τη σειρά των σημειωτών ενότητας εγγενώς."

#: Mcp/Actions.php:501
msgid "Retain every current status and section marker exactly once."
msgstr "Διατηρήστε κάθε τρέχουσα κατάσταση και σημειωτή ενότητας ακριβώς μία φορά."

#: Mcp/Actions.php:504
msgid "Keep statuses within the sections allowed by the native workflow editor."
msgstr ""
"Διατηρήστε τις καταστάσεις εντός των τμημάτων που επιτρέπονται από τον "
"εγγενή επεξεργαστή ροής εργασίας."

#: Mcp/Actions.php:631
msgid "Select a native permission-inheritance choice from discovery."
msgstr "Επιλέξτε μια επιλογή κληρονομικότητας άδειας εγγενώς από την ανακάλυψη."

#: Mcp/Actions.php:730
msgid "Use native editing for post types without REST support."
msgstr ""
"Χρησιμοποιήστε την εγγενή επεξεργασία για τύπους αναρτήσεων χωρίς "
"υποστήριξη REST."

#: Mcp/Actions.php:734
msgid "This post type uses a custom controller; use its native editor."
msgstr ""
"Αυτός ο τύπος ανάρτησης χρησιμοποιεί έναν προσαρμοσμένο ελεγκτή. "
"Χρησιμοποιήστε τον εγγενή επεξεργαστή του."

#: Mcp/Actions.php:785
msgid "A post may occur only once in a batch."
msgstr "Μια ανάρτηση μπορεί να εμφανιστεί μόνο μία φορά σε μια παρτίδα."

#: Mcp/Actions.php:813
msgid "Only user-created statuses can be deleted through MCP."
msgstr ""
"Μόνο οι καταστάσεις που δημιουργούνται από χρήστες μπορούν να διαγραφούν "
"μέσω MCP."

#: Mcp/Actions.php:819
msgid "Move or remove child statuses before deleting their parent."
msgstr ""
"Μετακινήστε ή αφαιρέστε τις παιδικές καταστάσεις πριν διαγράψετε τον γονέα "
"τους."

#: Mcp/Actions.php:822
msgid "Choose the native deletion destination, Draft."
msgstr "Επιλέξτε τον εγγενή προορισμό διαγραφής, Σχέδιο."

#: Mcp/Actions.php:826
msgid "Remove native visibility conditions before deleting this status."
msgstr ""
"Αφαιρέστε τις εγγενείς συνθήκες ορατότητας πριν διαγράψετε αυτή την "
"κατάσταση."

#: Mcp/Actions.php:839
msgid ""
"Revision records still use this definition. Use the native revision "
"workflow."
msgstr ""
"Τα αρχεία αναθεώρησης εξακολουθούν να χρησιμοποιούν αυτόν τον ορισμό. "
"Χρησιμοποιήστε την εγγενή ροή εργασίας αναθεώρησης."

#: Mcp/Actions.php:842
msgid "Use native administration for this deletion."
msgstr "Χρησιμοποιήστε την εγγενή διαχείριση για αυτή τη διαγραφή."

#: Mcp/Actions.php:858
msgid "Use native administration to reassign posts with visibility locks."
msgstr ""
"Χρησιμοποιήστε την εγγενή διαχείριση για να επανακατανείμετε αναρτήσεις με "
"κλειδώματα ορατότητας."

#: Mcp/bootstrap.php:17
msgid "PublishPress plugin actions."
msgstr "Δράσεις πρόσθετου PublishPress."

#: Mcp/Registry.php:42
msgid "Use the exact fields, types and choices returned by discovery."
msgstr ""
"Χρησιμοποιήστε τα ακριβή πεδία, τύπους και επιλογές που επιστρέφονται από "
"την ανακάλυψη."

#: Mcp/Registry.php:47
